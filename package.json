{
  "name": "flowdoc-fontend-spike",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && esbuild scripts/preview-watermark-entry.mjs --bundle --platform=node --format=cjs --loader:.png=base64 --outfile=dist/preview-watermark-runtime.cjs",
    "test": "node --test tests/*.test.mjs",
    "check:browser": "node scripts/browser-check.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:core-layout": "node scripts/build-core-layout.mjs",
    "check:live": "node scripts/live-input-check.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "prosemirror-commands": "^1.7.0",
    "prosemirror-history": "^1.4.0",
    "prosemirror-keymap": "^1.2.0",
    "prosemirror-model": "^1.25.0",
    "prosemirror-state": "^1.4.0",
    "prosemirror-view": "^1.42.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.0",
    "vite": "^8.3.6"
  },
  "version": "0.1.0"
}
